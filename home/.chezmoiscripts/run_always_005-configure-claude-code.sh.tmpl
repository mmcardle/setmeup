#!/bin/bash
# Configure Claude Code settings (runs on every chezmoi apply)
set -e

echo "[setmeup] Configuring Claude Code settings..."

export PATH="$HOME/.local/bin:$PATH"

SETTINGS_FILE="$HOME/.claude/settings.json"

mkdir -p "$HOME/.claude"

# Define the statusLine and MCP configs to merge
STATUSLINE_JSON='{"statusLine":{"type":"command","command":"bash ~/.claude/statusline-command.sh"}}'
PLAYWRIGHT_MCP_JSON='{"mcpServers":{"playwright":{"command":"npx","args":["-y","@playwright/mcp@latest"]}}}'

# Permissions to ensure are in the allow list
REQUIRED_PERMISSIONS=(
    'Read(~/.claude/skills/*)'
    'Bash(make *)'
)

# Claude-waiting hooks: each event runs the same flag-writer script with a
# different argument so tmux/sesh can surface which Claude sessions are busy,
# idle, or asking for attention.
FLAG_BIN="$HOME/.local/bin/claude-waiting-flag.sh"
HOOKS_JSON=$(cat <<HOOKS
{
  "hooks": {
    "Notification":     [{"hooks": [{"type":"command","command":"$FLAG_BIN attention"}]}],
    "Stop":             [{"hooks": [{"type":"command","command":"$FLAG_BIN idle"}]}],
    "UserPromptSubmit": [{"hooks": [{"type":"command","command":"$FLAG_BIN running"}]}],
    "SessionEnd":       [{"hooks": [{"type":"command","command":"$FLAG_BIN clear"}]}]
  }
}
HOOKS
)

if [[ -f "$SETTINGS_FILE" ]]; then
    # Merge statusLine and Playwright MCP into existing settings, preserving all other keys
    jq --argjson sl "$STATUSLINE_JSON" --argjson mcp "$PLAYWRIGHT_MCP_JSON" '. * $sl * $mcp' "$SETTINGS_FILE" > "${SETTINGS_FILE}.tmp"
    mv "${SETTINGS_FILE}.tmp" "$SETTINGS_FILE"
else
    # Create new settings file with statusLine and Playwright MCP
    jq -n --argjson sl "$STATUSLINE_JSON" --argjson mcp "$PLAYWRIGHT_MCP_JSON" '$sl * $mcp' > "$SETTINGS_FILE"
fi

# Ensure required permissions are present in the allow list
for perm in "${REQUIRED_PERMISSIONS[@]}"; do
    if ! jq -e --arg p "$perm" '.permissions.allow // [] | index($p)' "$SETTINGS_FILE" > /dev/null 2>&1; then
        jq --arg p "$perm" '.permissions.allow = ((.permissions.allow // []) + [$p])' "$SETTINGS_FILE" > "${SETTINGS_FILE}.tmp"
        mv "${SETTINGS_FILE}.tmp" "$SETTINGS_FILE"
    fi
done

# Merge claude-waiting hooks. Each event is set to exactly the setmeup hook
# definition so re-running chezmoi apply converges to the same state; if the
# user wants extra hooks on these events, they can append additional entries
# manually and only the setmeup-named command is reset here.
for event in Notification Stop UserPromptSubmit SessionEnd; do
    expected=$(jq -r --arg e "$event" '.hooks[$e]' <<<"$HOOKS_JSON")
    jq --arg e "$event" --argjson v "$expected" \
        '.hooks = ((.hooks // {}) + {($e): $v})' \
        "$SETTINGS_FILE" > "${SETTINGS_FILE}.tmp"
    mv "${SETTINGS_FILE}.tmp" "$SETTINGS_FILE"
done

echo "[setmeup] Claude Code settings configured."

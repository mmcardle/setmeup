#!/usr/bin/env bash
# Install Claude Code plugins (full plugins: skills + commands + agents +
# hooks + MCP servers) and Codex-only skills. Re-runs when this script,
# either list, or the mise config changes.
# hash:                 {{ include ".chezmoiscripts/run_after_onchange_004-install-agent-skills.sh.tmpl" | sha256sum }}
# mise config hash:     {{ include "dot_config/mise/config.toml" | sha256sum }}
# claude plugins hash:  {{ include "dot_config/setmeup/claude-plugins.list" | sha256sum }}
# claude installer hash:{{ include "dot_local/bin/executable_setmeup-install-claude-plugins.sh" | sha256sum }}
# codex skills hash:    {{ include "dot_config/setmeup/codex-skills.list" | sha256sum }}
set -e

export PATH="$HOME/.local/bin:$PATH"

CLAUDE_PLUGINS_LIST="{{ .chezmoi.sourceDir }}/dot_config/setmeup/claude-plugins.list"
CODEX_SKILLS_LIST="{{ .chezmoi.sourceDir }}/dot_config/setmeup/codex-skills.list"

# --- Claude Code plugins (native plugin manager) -------------------------

if [[ ! -f "$CLAUDE_PLUGINS_LIST" ]]; then
    echo "[setmeup] ERROR: claude-plugins.list not found at $CLAUDE_PLUGINS_LIST"
    exit 1
fi

echo "[setmeup] Installing Claude Code plugins..."

# Claude Code is installed as an npm tool by mise; chain node@lts so npm
# is on PATH (mise needs npm to resolve the npm:@... tool), then claude
# itself comes from the npm package.
CLAUDE_EXEC=(mise exec node@lts 'npm:@anthropic-ai/claude-code' --)

ensure_claude_native_binary() {
    local claude_install_dir install_cjs

    # mise's npm backend installs with --ignore-scripts=true, but Claude Code's
    # npm wrapper requires postinstall to copy the platform-native binary over
    # bin/claude.exe. Run that postinstall explicitly before using the plugin CLI.
    # The package's path under the mise install dir varies between mise/npm
    # versions (lib/node_modules vs node_modules), so search for install.cjs
    # instead of deriving its location from the claude binary's path.
    claude_install_dir="$(mise where 'npm:@anthropic-ai/claude-code')"
    install_cjs="$(find "$claude_install_dir" -name install.cjs -path '*/claude-code/*' -not -path '*/claude-code/node_modules/*' | head -n 1)"

    if [[ -z "$install_cjs" ]]; then
        echo "[setmeup] ERROR: Claude Code postinstall script (install.cjs) not found under $claude_install_dir"
        exit 1
    fi

    echo "[setmeup] Repairing Claude Code native binary..."
    mise exec node@lts -- node "$install_cjs"
    "${CLAUDE_EXEC[@]}" claude --version >/dev/null
}

ensure_claude_native_binary

# Register marketplaces and install missing plugins via the shared helper.
# The helper skips plugins that are already installed, so re-running this
# installer never re-enables a plugin the user has chosen to disable.
"$HOME/.local/bin/setmeup-install-claude-plugins.sh" "$CLAUDE_PLUGINS_LIST"

# --- Codex-only skills (npx skills) --------------------------------------

if [[ -f "$CODEX_SKILLS_LIST" ]]; then
    codex_lines=$(grep -vE '^\s*(#|$)' "$CODEX_SKILLS_LIST" || true)
    if [[ -n "$codex_lines" ]]; then
        echo "[setmeup] Installing Codex skills via npx..."
        while read -r package; do
            [ -z "${package:-}" ] && continue
            echo "[setmeup]   codex skills add: $package"
            # `skills` CLI has no --quiet flag; capture output and only show it
            # on failure. `npx --silent` suppresses npm's own chatter.
            skill_log=$(mktemp)
            if ! mise exec node@lts -- npx --silent -y skills add "$package" -a codex -g -y </dev/null >"$skill_log" 2>&1; then
                cat "$skill_log" >&2
                rm -f "$skill_log"
                exit 1
            fi
            rm -f "$skill_log"
        done <<< "$codex_lines"
    fi
fi

echo "[setmeup] Agent skills and plugins installed."
